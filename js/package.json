{
  "name": "kolavid",
  "version": "0.1.0",
  "description": "Official JavaScript and TypeScript client for the KolaVid API: turn a prompt, text or web page into a narrated whiteboard explainer video.",
  "keywords": ["kolavid", "video", "whiteboard", "explainer", "api", "sdk", "ai"],
  "homepage": "https://kolavid.com/developers",
  "bugs": { "email": "support@kolavid.com" },
  "license": "MIT",
  "author": "Kola Labs Ltd <support@kolavid.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/client.test.mjs",
    "prepublishOnly": "npm run build && node --test test/client.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
